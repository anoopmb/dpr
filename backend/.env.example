ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://dpr_user:dpr_password@localhost:5432/dpr_db
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# STORAGE_BACKEND=s3 uses the S3_* settings below (MinIO/AWS S3).
# STORAGE_BACKEND=local writes under LOCAL_UPLOAD_DIR and serves it back
# at PUBLIC_BASE_URL/uploads — no MinIO needed, for local dev only.
STORAGE_BACKEND=s3
LOCAL_UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dpr-files
